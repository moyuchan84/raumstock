{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "serve-prototype",
      "type": "shell",
      "command": "node scripts/serve.mjs 8000",
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": { "regexp": "^__never__$" },
        "background": {
          "activesBegin": true,
          "beginsPattern": "Raumstock prototype",
          "endsPattern": "http://localhost:\d+"
        }
      }
    },
    {
      "label": "build-data",
      "type": "shell",
      "command": "node scripts/build-data.mjs",
      "problemMatcher": []
    }
  ]
}
